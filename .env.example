# Anthropic API key — ใช้เรียก Companion agent, Risk engine, Output auditor
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Google Gemini API key — ใช้เรียก Clinical Summary agent
# สร้างจาก Google AI Studio และห้าม commit key จริง
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Mistral API key — optional ใช้เฉพาะ cross-provider Fallback Mesh เมื่อกำหนด
# HYDRA_RISK_SECONDARY_MODEL หรือ HYDRA_COMPANION_SECONDARY_MODEL ด้านล่าง
MISTRAL_API_KEY=

# Prisma + SQLite — ไฟล์ dev.db สร้างเองตอนรัน `npm run db:migrate` (ไม่ต้อง commit)
DATABASE_URL="file:./dev.db"

# Master key สำหรับห่อ (wrap) กุญแจเข้ารหัสของผู้ป่วยแต่ละคน (envelope encryption
# ดู lib/patient-encryption.ts และ PRODUCTION_ROADMAP.md) ห้ามใช้ค่าเดียวกับ
# SESSION_SECRET เด็ดขาด — คนละหน้าที่กัน สร้างด้วย:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PATIENT_DATA_MASTER_KEY=

# Secret สำหรับ sign session JWT — สุ่มอย่างน้อย 32 ตัวอักษร ห้ามใช้ค่าตัวอย่างนี้จริง
# สร้างได้ด้วย: openssl rand -base64 32
SESSION_SECRET=replace-with-a-real-random-32-plus-character-string

NODE_ENV=development

# เปิด demo login (ไม่ใช่ authentication จริง) เพื่อทดสอบ pipeline ทั้งระบบได้
# ก่อนมี login flow จริง — ห้ามตั้ง true บน production เด็ดขาด
DEMO_AUTH_ENABLED=true

# Fallback Mesh: optional cross-provider responders. Set approved model IDs after
# benchmarking; empty means disabled. Auditor remains independent and mandatory.
HYDRA_RISK_SECONDARY_MODEL=
HYDRA_COMPANION_SECONDARY_MODEL=

# Durable outbox: absolute path on a persistent local volume (NOT /tmp/serverless).
# Create a dedicated 32-byte hex key: openssl rand -hex 32
# Keep this key separate from SESSION_SECRET and PATIENT_DATA_MASTER_KEY.
HYDRA_OUTBOX_DIR=
HYDRA_OUTBOX_KEY=
# Run `npm run outbox:retry` periodically under your process supervisor/cron.
